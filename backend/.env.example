# Copy to .env and fill in. NEVER commit .env. Placeholders only.

APP_ENV=development                # production in hosted environments
SECRET_KEY=                        # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
BASE_URL=http://localhost:8000     # public URL of THIS backend API (Google OAuth callback = BASE_URL/auth/callback)
FRONTEND_URL=http://localhost:5173 # public URL of the separate frontend (Vercel). The QR code points here. HTTPS in production.
CORS_EXTRA_ORIGINS=                # extra allowed frontend origins, comma separated (e.g. http://localhost:4173)
COOKIE_SAMESITE=lax                # lax: frontend+API on the same registrable domain; none: different sites (needs COOKIE_SECURE=true)
COOKIE_DOMAIN=                     # e.g. .gwcdata.ai when using app.gwcdata.ai + api.gwcdata.ai
DATABASE_URL=sqlite:///./storage/dev.db   # production: postgresql://USER:PASSWORD@HOST:5432/attendance
REPORTS_DIR=./storage/reports      # keep OUTSIDE any web-served folder
TIMEZONE=Asia/Kolkata

# --- Company sign-in (Google Workspace OpenID Connect) ---
ALLOWED_EMAIL_DOMAIN=gwcdata.ai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=              # redirect URI to register: <BASE_URL>/auth/callback
DEV_AUTH_ENABLED=false             # true ONLY on a developer machine; startup refuses it in production
COOKIE_SECURE=false                # true in production (HTTPS)
SESSION_MAX_AGE_SECONDS=43200
ADMIN_REAUTH_MINUTES=60
BOOTSTRAP_ADMIN_EMAILS=            # comma separated @gwcdata.ai addresses seeded as SUPER_ADMIN at startup
REQUIRE_MASTER_LIST=true           # only employees imported by HR can register

# Employees can punch from ANY network (office, home, mobile data) and choose WFO / WFH / WFCO at each Punch In.
# The client IP is recorded for audit + rate limiting; X-Forwarded-For is trusted ONLY from these proxies.
TRUSTED_PROXIES=                   # CIDRs of YOUR reverse proxy/load balancer; X-Forwarded-For ignored otherwise

# --- Attendance policy ---
# Shifts and late/early tolerances are NOT configured here: HR maintains them in the workbook's
# Shift Master / Employee Master sheets (apply with scripts/import_hr_workbook.py). No shift = flagged, never guessed.
MIN_SECONDS_BETWEEN_PUNCHES=30
STALE_SESSION_HOURS=18
WORKING_DAYS=0,1,2,3,4             # Monday=0
ATTENDANCE_POLICY_FILE=            # optional path to HR-authored policy text the assistant may quote verbatim

# --- Proactive monitoring (Python scheduler; LLM only runs when there are NEW findings) ---
MONITOR_ENABLED=false
MONITOR_INTERVAL_MINUTES=30
ASSISTANT_RATE_LIMIT=20            # assistant chat messages per minute per client


# --- Domo LLM (nothing is assumed; take values from your Domo AI documentation) ---
DOMO_INSTANCE_URL=                 # https://<yourcompany>.domo.com
DOMO_DEVELOPER_TOKEN=              # credential for your Domo AI service
DOMO_AUTH_HEADER=X-DOMO-Developer-Token
DOMO_LLM_ENDPOINT_PATH=            # path of the AI/LLM endpoint enabled for your account
DOMO_LLM_MODEL=                    # optional model name/id as listed by Domo
DOMO_LLM_INPUT_FIELD=input         # JSON request field carrying the prompt
DOMO_LLM_MODEL_FIELD=model
DOMO_LLM_RESPONSE_FIELD=output     # dot-path to the generated text in the JSON response, e.g. choices.0.text
